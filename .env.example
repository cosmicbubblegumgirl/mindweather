# Enables Google account sign-in and the optional read-only Calendar connection.
# This is a public browser client ID, not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public browser configuration for Supabase Auth and protected app data.
# Store deployment values as GitHub repository variables, not in source control.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Bloopy's private configuration belongs in Supabase Edge Function secrets,
# never in NEXT_PUBLIC_* variables or the static website build:
# supabase secrets set OPENAI_API_KEY=... SITE_URL=https://mymindweather.study
# Optional: supabase secrets set OPENAI_MODEL=gpt-5.4-mini
