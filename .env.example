# MindWeather runs locally without environment variables.
# These names are reserved for an optional hosted storage adapter. Never place
# service-role secrets in client-side code or commit a real .env.local file.
NEXT_PUBLIC_STORAGE_MODE=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Google Calendar + Classroom connection. Keep every value server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Use separate, randomly generated values with at least 32 bytes of entropy.
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_SESSION_SECRET=

# Background email summaries and reminders (Resend + a 15-minute scheduler).
RESEND_API_KEY=
REMINDER_EMAIL_FROM="MindWeather <reminders@example.com>"
CRON_SECRET=
